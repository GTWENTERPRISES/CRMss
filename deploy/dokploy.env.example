# Variables del backend en Dokploy (pestaña Environment del servicio Compose).
# Generar cada clave con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Guarda FIELD_ENCRYPTION_KEY y CREDENTIALS_KEY también fuera del servidor:
# sin ellas los datos cifrados no se pueden leer.

DJANGO_SECRET_KEY=
FIELD_ENCRYPTION_KEY=
CREDENTIALS_KEY=
CLAVE_INTERNA_MW=
DJANGO_SERVICIO_EMAIL=servicio@middleware.local
DJANGO_SERVICIO_CLAVE=

# El primer administrador del panel (se crea solo si no existe).
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_CLAVE=

# El dominio del backend en Dokploy y el del frontend en Vercel.
DJANGO_ALLOWED_HOSTS=api.ejemplo.com
CORS_ALLOWED_ORIGINS=https://cr-mss.vercel.app
DJANGO_TIME_ZONE=America/Guayaquil

# 1 = sin automatismos contra OLT/MikroTik (copias de prueba).
TAREAS_APAGADAS=

# Correo saliente (SMTP).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
