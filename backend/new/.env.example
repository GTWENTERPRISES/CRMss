# ==============================================================================
# DJANGO CONFIGURATION
# ==============================================================================
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key-in-production
# Clave del cifrado de datos personales en la base (al menos 32 caracteres al azar).
# Sin ella nadie puede leer los datos: guárdala fuera del servidor también.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
FIELD_ENCRYPTION_KEY=change-this-for-field-encryption
# Claves anteriores, solo para leer al rotarla (manage.py recifrar). Separadas por coma.
FIELD_ENCRYPTION_KEYS_ANTERIORES=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*
DJANGO_TIME_ZONE=America/Guayaquil
DJANGO_LOG_LEVEL=INFO

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_isp
DB_ENGINE=postgresql
DB_NAME=crm_isp
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Docker PostgreSQL
POSTGRES_DB=crm_isp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ==============================================================================
# CELERY & REDIS CONFIGURATION
# ==============================================================================
CELERY_BROKER_URL=redis://:redispass@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:redispass@localhost:6379/1
REDIS_PASSWORD=redispass
REDIS_PORT=6379

# ==============================================================================
# WHATSAPP BUSINESS API
# ==============================================================================
# Obtener tokens en: https://developers.facebook.com/apps/
WHATSAPP_TOKEN=your_whatsapp_business_api_token_here
WHATSAPP_PHONE_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_for_webhooks

# ==============================================================================
# SRI ECUADOR - FACTURACIÓN ELECTRÓNICA
# ==============================================================================
# Ambiente: 1=Pruebas, 2=Producción
SRI_AMBIENTE=1
SRI_RUC_EMPRESA=1234567890001
SRI_RAZON_SOCIAL=MI ISP S.A.
SRI_NOMBRE_COMERCIAL=MI ISP
SRI_DIRECCION_MATRIZ=Av. Principal 123, Ciudad, Ecuador

# URLs SRI (Pruebas)
SRI_URL_RECEPCION=https://cel.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl
SRI_URL_AUTORIZACION=https://cel.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl

# Certificado Digital .p12 (ruta completa al archivo)
SRI_CERTIFICADO_PATH=/path/to/certificado.p12
SRI_CERTIFICADO_PASSWORD=password_del_certificado

# ==============================================================================
# CONFIGURACIONES DE NEGOCIO
# ==============================================================================
# IVA en Ecuador: 12% (usar 12, no 0.12)
IVA_PORCENTAJE=12

# Días de gracia después de vencimiento antes de corte automático
DIAS_MORA_CORTE=5

# Emails de administradores (separados por coma)
ADMIN_EMAILS=admin@miempresa.com,soporte@miempresa.com

# ==============================================================================
# CORS & SECURITY
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DRF_ANON_RATE=60/minute
DRF_USER_RATE=600/minute

# WebSockets / Channel layer
CHANNEL_REDIS_URL=redis://:redispass@localhost:6379/2

# TR-069 / ACS compatible with GenieACS NBI (optional)
TR069_ACS_URL=http://localhost:7557
TR069_ACS_USERNAME=
TR069_ACS_PASSWORD=
TR069_TIMEOUT=15

# ==============================================================================
# EMAIL — por acá salen los códigos de recuperación de contraseña
# ==============================================================================
# Con EMAIL_HOST vacío el correo se muestra en el log de Django (desarrollo).
# Gmail: activar la verificación en dos pasos y usar una "contraseña de
# aplicación" (myaccount.google.com/apppasswords), no la clave de la cuenta.
# Puerto 587 = STARTTLS; 465 = SSL (se activa solo con ese puerto).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion
DEFAULT_FROM_EMAIL=Taller SmartOLT <tu-email@gmail.com>

# Límites por IP de la recuperación (rutas públicas).
DRF_RECUPERAR_RATE=5/hour
DRF_VERIFICAR_RATE=20/hour

# ==============================================================================
# FLOWER - MONITOREO DE CELERY (opcional)
# ==============================================================================
FLOWER_USER=admin
FLOWER_PASSWORD=admin
FLOWER_PORT=5555

# ==============================================================================
# DOCKER PORTS
# ==============================================================================
WEB_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Respaldos ──────────────────────────────────────────────────────────────
# Celery Beat respalda la base y los archivos cada noche y prueba que la copia
# se pueda restaurar. A mano: python manage.py respaldar
# La FIELD_ENCRYPTION_KEY NO va en la carpeta de respaldos: guardala aparte.
RESPALDOS_DIR=
RESPALDOS_CONSERVAR=14
RESPALDOS_HORA=03:15
