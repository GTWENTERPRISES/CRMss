# =============================================================================
# Web del ambiente de PRUEBA — copiar a .env.local y completar
# =============================================================================
# El navegador habla con Django (el único backend). Todo apunta al ambiente
# de prueba: el Django de prueba (puerto 8100, por ejemplo) con su PostgreSQL
# propio, y su servicio de red interno detrás de /api/v1/red/.
# =============================================================================

NEXT_PUBLIC_DJANGO_API_URL=http://localhost:8100/api/v1

# El módulo de red entra SIEMPRE por el Django de prueba.
NEXT_PUBLIC_API_URL=http://localhost:8100/api/v1/red

# En false: se prueba con el sistema de verdad, no con datos simulados.
NEXT_PUBLIC_DEMO_MODE=false

# Identificación del ambiente. En producción esta línea NO va.
NEXT_PUBLIC_AMBIENTE=prueba

# Si se publica en un servidor, usar la URL pública del Django de prueba:
# NEXT_PUBLIC_API_URL=https://prueba.smartbotai.net/api/v1/red
# Cambiar estas variables obliga a volver a correr `npm run build`.
