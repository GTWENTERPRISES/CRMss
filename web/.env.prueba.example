# =============================================================================
# Web del ambiente de PRUEBA — copiar a .env.local y completar
# =============================================================================
# El navegador habla con Supabase directamente para la sesión del usuario.
# Los dos lados tienen que apuntar al mismo proyecto de prueba.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://EL-PROYECTO-DE-PRUEBA.supabase.co

# La clave ANÓNIMA, no la service_role. Esta viaja al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# El middleware de prueba, que escucha en 4900. Sin /api al final.
NEXT_PUBLIC_API_URL=http://localhost:4900

# En false: se prueba con el sistema de verdad, no con datos simulados.
NEXT_PUBLIC_DEMO_MODE=false

# Identificación del ambiente. En producción esta línea NO va.
NEXT_PUBLIC_AMBIENTE=prueba

# Si se publica en un servidor, usar la URL pública del middleware:
# NEXT_PUBLIC_API_URL=https://prueba.smartbotai.net
# Cambiar estas variables obliga a volver a correr `npm run build`.
