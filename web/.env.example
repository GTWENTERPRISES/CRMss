# Copiá este archivo como .env.local y completá los valores reales.
# Next.js expone al navegador las variables que empiezan con NEXT_PUBLIC_.

# ============================================================================
# BACKEND DJANGO — el único backend del sistema
# ============================================================================
# CRUD, autenticación, storage y también el módulo de red, que Django
# reenvía al servicio interno (middleware/) desde /api/v1/red/...
NEXT_PUBLIC_DJANGO_API_URL=http://localhost:8000/api/v1

# El módulo de red del navegador entra SIEMPRE por Django.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1/red

# ============================================================================
# MODO DEMO
# ============================================================================
# Modo demo: permite recorrer la interfaz sin backend ni equipos de red.
# Datos de ejemplo en memoria, se pierden al recargar. Dejar en false para uso real.
NEXT_PUBLIC_DEMO_MODE=false

