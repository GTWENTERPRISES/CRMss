# Copiá este archivo como .env.local y completá los valores reales.
# Next.js expone al navegador las variables que empiezan con NEXT_PUBLIC_.

# ============================================================================
# BACKEND DJANGO (nuevo)
# ============================================================================
NEXT_PUBLIC_DJANGO_API_URL=http://localhost:8000/api/v1

# ============================================================================
# SUPABASE (mantener para migración gradual, luego eliminar)
# ============================================================================
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Usá la anon/publishable key, NUNCA la service_role (esta viaja al navegador).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ============================================================================
# MIDDLEWARE DE RED (opcional, si todavía lo usás)
# ============================================================================
# URL del middleware de red
NEXT_PUBLIC_API_URL=http://localhost:4000

# ============================================================================
# MODO DEMO
# ============================================================================
# Modo demo: permite recorrer la interfaz sin Supabase ni equipos de red.
# Datos de ejemplo en memoria, se pierden al recargar. Dejar en false para uso real.
NEXT_PUBLIC_DEMO_MODE=false
